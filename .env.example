# Multimodal RAG — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Google Gemini API Key (REQUIRED for embeddings + generation) ───────────
#   Get one free at: https://aistudio.google.com/app/apikey
#   Used by:
#     • Embedding model : gemini-embedding-exp-03-07  (multimodal, 3072-dim)
#     • Generation model: gemini-2.0-flash            (vision + text answers)
GEMINI_API_KEY=your_gemini_api_key_here

# ── 2. ChromaDB (local, no setup needed) ──────────────────────────────────────
#   ChromaDB runs fully locally in .chroma_db/ — no cloud account required.
#   Optionally override the collection name below:
CHROMA_COLLECTION=rag_documents

# ── 3. Groq LLM Key (Optional — alternative text-only generation model) ───────
#   Get one free at: https://console.groq.com/keys
#   When set, the Web UI will offer "Groq Llama" as an LLM option.
#   Model used: llama-3.3-70b-versatile
# GROQ_API_KEY=your_groq_api_key_here

# ── 4. Amazon Bedrock (Optional — AWS-hosted Claude / Nova models) ─────────────
#   Requires an AWS account with Bedrock model access enabled.
#   Docs: https://docs.aws.amazon.com/bedrock/latest/userguide/getting-started.html
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
